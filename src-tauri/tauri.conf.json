{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileForge",
  "version": "0.1.2",
  "identifier": "com.spiriturban.fileforge",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FileForge",
        "width": 960,
        "height": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Spirit Urban",
    "copyright": "Copyright © 2026 Spirit Urban",
    "resources": [
      "resources/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEMDkxQTMzRTc3RTRCNTIKUldSU1MzN25NeG9KalVKc0t1QzRLdzFJd1A3QzQxKzFRSFhaSjZuYVNTOUhjSTVUby9aSTE2NHYK",
      "endpoints": [
        "https://github.com/SpiritUrban/file-forge/releases/latest/download/latest.json"
      ]
    }
  }
}
